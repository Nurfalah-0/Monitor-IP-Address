{
  "name": "@netlify/sdk--ui-react",
  "version": "2.1.2",
  "author": "Netlify, Inc.",
  "description": "A React-based toolkit for building UI extensions on top of the Netlify platform.",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist/**",
    "lib/**"
  ],
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./components": {
      "types": "./dist/components/main.d.ts",
      "default": "./dist/components/main.js"
    },
    "./styles.css": {
      "import": "./dist/assets/main.css"
    },
    "./tailwind-config": {
      "default": "./lib/tailwind.config.ts"
    },
    "./unstable": {
      "types": "./dist/unstable/main.d.ts",
      "default": "./dist/unstable/main.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "Safari >= 15",
      "last 2 Edge versions",
      "last 2 Firefox versions",
      "Firefox ESR",
      "> 1%",
      "not IE 11",
      "not op_mini all"
    ],
    "modern": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "dependencies": {
    "@fullstory/browser": "^2.0.5",
    "@hookform/resolvers": "^3.9.0",
    "@netlify/netlify-design-tokens": "^7.1.0",
    "@netlify/tailwind-config": "^2.1.0",
    "@netlify/ui": "0.0.23",
    "@react-hook/resize-observer": "^2.0.1",
    "escape-string-regexp": "^5.0.0",
    "hast-util-to-jsx-runtime": "^2.3.0",
    "history": "^5.3.0",
    "react-hook-form": "^7.52.0",
    "react-select": "^5.8.0",
    "shiki": "^1.18.0",
    "zod": "^3.23.8",
    "@netlify/sdk--ui-core": "2.0.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/builder-vite": "^10.6.1",
    "@storybook/csf": "^0.1.11",
    "@storybook/icons": "^2.1.0",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tanstack/react-query": "^5.90.10",
    "@trpc/client": "^11.7.1",
    "@trpc/react-query": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "@tsconfig/vite-react": "^3.0.2",
    "@types/eslint": "^9.6.1",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "autoprefixer": "^10.4.7",
    "chromatic": "^13.3.4",
    "dedent": "^1.7.0",
    "delay": "^7.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "10.6.1",
    "glob": "^13.0.0",
    "lodash.merge": "^4.6.2",
    "msw": "^2.12.2",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.56.1",
    "prettier": "3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.1.0",
    "utility-types": "^3.11.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^5.0.4",
    "@netlify/sdk--eslint-config": "0.0.0",
    "@netlify/sdk--typescript-config": "0.0.0",
    "@netlify/sdk--ui-functions": "2.0.5"
  },
  "peerDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch --clearScreen=false",
    "clean": "rm -rf dist/ *.tsbuildinfo storybook-static/",
    "lint": "eslint",
    "prebuild": "pnpm run typecheck-buildonly",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck-buildonly": "tsc --project tsconfig.build.json --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  }
}